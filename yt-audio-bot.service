[Unit]
Description=YouTube to Audio Telegram Bot
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/yt-audio-bot
Environment="YT_AUDIO_BOT_TOKEN=your_bot_token_from_botfather"
Environment="YT_AUDIO_ADMIN_ID=your_telegram_user_id"
Environment="YT_AUDIO_VIP_USERS=your_telegram_user_id"
Environment="YT_AUDIO_COOKIES=/opt/yt-audio-bot/cookies.txt"
Environment="YTDLP_PATH=/opt/yt-audio-bot/venv/bin/yt-dlp"
Environment="YT_AUDIO_COOKIES_REMIND_DAYS=14"
Environment="YT_AUDIO_DB=/opt/yt-audio-bot/bot.db"
Environment="YT_AUDIO_CLIENTS=android,mweb,ios,web,tv"
Environment="YT_AUDIO_POT_ENABLED=1"
Environment="YT_AUDIO_POT_URL=http://127.0.0.1:4416"
Environment="YT_AUDIO_JS_RUNTIME=node:/usr/local/bin/node"
Environment="YT_AUDIO_DOWNLOAD_TIMEOUT=1800"
Environment="YT_AUDIO_EXTRACT_TIMEOUT=300"
Environment="YT_AUDIO_ROUNDS=3"
Environment="YT_AUDIO_ROUND_DELAY=10"
# Optional: set YT_AUDIO_PROXIES (comma-separated) or YT_AUDIO_PROXY to route yt-dlp
# through a proxy and avoid YouTube datacenter-IP bot checks.
Environment="YT_AUDIO_PROXIES="
Environment="YT_AUDIO_PROXY="
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/.deno/bin"
ExecStart=/opt/yt-audio-bot/venv/bin/python3 /opt/yt-audio-bot/bot.py
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
